{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Average request latency by endpoint",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (route) (rate(attack_http_request_duration_ms_sum[5m])) / clamp_min(sum by (route) (rate(attack_http_request_duration_ms_count[5m])), 0.001)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "HTTP error rate by endpoint",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (route) (rate(attack_http_request_errors_total[5m])) / clamp_min(sum by (route) (rate(attack_http_requests_total[5m])), 1)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "OCSP cache hit rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(attack_ocsp_cache_hits_total[10m])) / clamp_min(sum(rate(attack_ocsp_cache_hits_total[10m])) + sum(rate(attack_ocsp_cache_misses_total[10m])), 1)",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "title": "Onboarding gate rejections",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (reason) (rate(attack_onboarding_rejections_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "title": "Rate-limit responses (HTTP 429)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (route) (rate(attack_http_requests_total{status=\"429\"}[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    }
  ],
